{
  "schema_version": 1,
  "events": {
    "project.grn_draft_saved": {
      "event_schema_version": 1,
      "description": "A user successfully temporarily saves an editable GRN draft without updating inventory.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "currency",
          "line_count"
        ],
        "properties": {
          "currency": {
            "type": "string",
            "enum": [
              "USD",
              "ZiG",
              "ZAR"
            ]
          },
          "line_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "project.grn_inventory_posted": {
      "event_schema_version": 1,
      "description": "The protected GRN posting operation succeeds after review confirmation.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "currency",
          "line_count"
        ],
        "properties": {
          "currency": {
            "type": "string",
            "enum": [
              "USD",
              "ZiG",
              "ZAR"
            ]
          },
          "line_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "project.grn_review_confirmed": {
      "event_schema_version": 1,
      "description": "A validated GRN review is confirmed and its snapshot is saved before requesting inventory posting.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "currency",
          "line_count"
        ],
        "properties": {
          "currency": {
            "type": "string",
            "enum": [
              "USD",
              "ZiG",
              "ZAR"
            ]
          },
          "line_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "project.offline_shift_closed": {
      "event_schema_version": 1,
      "description": "A cashier ended a shift on the till without internet; it uploads later.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "opened_offline"
        ],
        "properties": {
          "opened_offline": {
            "type": "boolean"
          }
        }
      }
    },
    "project.offline_sync_completed": {
      "event_schema_version": 1,
      "description": "A till upload run finished after sending queued offline sales or an offline shift closure.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "synced",
          "failed",
          "shift_close_uploaded"
        ],
        "properties": {
          "synced": {
            "type": "number"
          },
          "failed": {
            "type": "number"
          },
          "shift_close_uploaded": {
            "type": "boolean"
          }
        }
      }
    },
    "project.offline_upload_failed": {
      "event_schema_version": 1,
      "description": "An offline sale, shift opening or shift closure failed to upload from the till.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "network"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "sale",
              "shift_open",
              "shift_close"
            ]
          },
          "network": {
            "type": "boolean"
          }
        }
      }
    },
    "project.till_sale_completed": {
      "event_schema_version": 1,
      "description": "A till sale completes after the protected online sale succeeds or the offline sale is successfully queued locally; queue uploads do not emit again. Group event times by Harare day; offline arrival is best-effort, not an accounting total.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mode",
          "currency"
        ],
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "online",
              "offline"
            ]
          },
          "currency": {
            "type": "string",
            "enum": [
              "USD",
              "ZiG",
              "ZAR"
            ]
          }
        }
      }
    },
    "project.trial_signup_completed": {
      "event_schema_version": 1,
      "description": "A new shop finished the /signup form and its 14-day trial store was created.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "trial_days"
        ],
        "properties": {
          "trial_days": {
            "type": "number"
          }
        }
      }
    }
  }
}
